# Normalize line endings to LF in the repo, checkout as-is on Windows
* text=auto eol=lf

# Go and Python source files — always LF
*.go text eol=lf
*.py text eol=lf
*.mod text eol=lf
*.sum text eol=lf

# Config files — always LF
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf
.gitignore text eol=lf

# Binaries — no line ending conversion
*.exe binary
*.dll binary
*.so binary
*.pyd binary
*.pyc binary
